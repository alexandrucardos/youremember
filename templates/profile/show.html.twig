{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
    <div class="container py-4">
        {#        <a href="javascript:history.back()" class="btn btn-secondary mb-3">← Back</a> #}
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h2 class="mb-3">{{ profile.name }}</h2>

                <p class="text-muted">
                    {{ profile.description|nl2br }}
                </p>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Born:</strong>
                        {{ profile.bornAt ? profile.bornAt|date('Y-m-d') : 'Unknown' }}
                    </div>

                    <div class="col-md-6">
                        <strong>Deceased:</strong>
                        {{ profile.deceasedAt ? profile.deceasedAt|date('Y-m-d') : 'Alive' }}
                    </div>
                </div>

                <hr>

                <h5>Images</h5>

                {% if images is empty %}
                    <p class="text-muted">No images available.</p>
                {% else %}
                    <div class="row g-3">
                        {% for image in images %}
                            <div class="col-md-4">
                                <img src="{{ image }}"
                                     class="img-fluid rounded shadow-sm"
                                     alt="Profile Image {{ loop.index }}">
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

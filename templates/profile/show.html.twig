{% extends 'base.html.twig' %}

{% block title %}Profile show{% endblock %}

{% block body %}
    <div class="container px-4">
        <div class="row">
            {{ include('content/profile/show.html.twig') }}
        </div>

        <h2 class="text-center">{{ profile.name }}</h2>

        <hr>

        <div class="row gy-3">
            <div class="col-md-6">
                <strong>Nascut:</strong>
                {{ profile.bornAt ? profile.bornAt|date('Y-m-d') : 'Nesetat' }}
            </div>

            <div class="col-md-6">
                <strong>Plecat:</strong>
                {{ profile.deceasedAt ? profile.deceasedAt|date('Y-m-d') : 'Nesetat' }}
            </div>
        </div>

        <hr>

        <p class="text-muted">
            {{ profile.description|nl2br }}
        </p>

        <hr>
        <div class="row">
            {{ include('content/pictures/show.html.twig', {images: images}) }}
        </div>
    </div>
{% endblock %}



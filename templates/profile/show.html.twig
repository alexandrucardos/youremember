{% extends 'base.html.twig' %}

{% block title %}Profile show{% endblock %}

{% block body %}
    <div class="container py-5 gallery-container position-relative">
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h2>{{ profile.name }}</h2>

                <p class="text-muted">
                    {{ profile.description|nl2br }}
                </p>

                <div class="row">
                    <div class="col-md-6">
                        <strong>Born:</strong>
                        {{ profile.bornAt ? profile.bornAt|date('Y-m-d') : 'Nesetat' }}
                    </div>

                    <div class="col-md-6">
                        <strong>Deceased:</strong>
                        {{ profile.deceasedAt ? profile.deceasedAt|date('Y-m-d') : 'Nesetat' }}
                    </div>
                </div>
                <hr>
                <div class="row">
                    {{ include('content/show.html.twig', {images: images}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}



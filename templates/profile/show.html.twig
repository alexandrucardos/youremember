{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
    <div class="container py-5 gallery-container position-relative">
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <h2 class="mb-3">{{ profile.name }}</h2>

                <p class="text-muted">
                    {{ profile.description|nl2br }}
                </p>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Born:</strong>
                        {{ profile.bornAt ? profile.bornAt|date('Y-m-d') : 'Unknown' }}
                    </div>

                    <div class="col-md-6">
                        <strong>Deceased:</strong>
                        {{ profile.deceasedAt ? profile.deceasedAt|date('Y-m-d') : 'Alive' }}
                    </div>
                </div>

                <hr>

                {% if images is empty %}
                    <p class="text-muted">No images available.</p>
                {% else %}
                    <div class="row">
                        {% for image in images %}
                            <div class="col-md-4 shadow-sm">
                                <a data-toggle="lightbox"
                                        {#                                   data-gallery="profile-gallery" #}
                                   href="{{ image }}"
                                >

                                    <img src="{{ image }}"
                                         class="img-fluid"
                                         alt="Profile Image {{ loop.index }}">
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bs5-lightbox@1.8.5/dist/index.bundle.min.js"></script>

        {# Fix background scroll when lightbox is open #}
        <script>
            document.addEventListener("lightbox:opened", function () {
                document.body.classList.add("overflow-hidden");
            });
            document.addEventListener("lightbox:closed", function () {
                document.body.classList.remove("overflow-hidden");
            });
        </script>
    {% endblock %}
{% endblock %}



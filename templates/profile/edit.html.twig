{% extends 'base.html.twig' %}

{% block title %}Editeaza profil{% endblock %}

{% block body %}
    <div class="container py-5 gallery-container position-relative">
        <a href="{{ path('app_profile_index') }}"
           class="btn btn-primary btn-sm col-sm-3"
        >
            Meniu principal
            <i class="bi bi-arrow-left"></i>
        </a>
        <br>

        <div class="row">
            {{ include('content/profile/show.html.twig') }}
        </div>

        <div class="row">
            {{ include('profile/form.html.twig', {'button_label': 'Update'}) }}
        </div>

        <div class="row">
            <div class="col-xl-4 col-sm-12">
                {{ include('content/profile/profile.form.html.twig', {'button_label': 'Update'}) }}
            </div>
            <div class="col-xl-4 col-sm-12">
                {{ include('content/profile/background.form.html.twig', {'button_label': 'Update'}) }}
            </div>

            <div class="col-xl-4 col-sm-12">
                {{ include('content/pictures/form.html.twig', {'button_label': 'Update'}) }}
            </div>
        </div>
        <br>
        <div class="row">
            <br>
            <button
                    type="button"
                    class="btn btn-primary btn-sm col-sm-3"
                    data-bs-toggle="modal"
                    data-bs-target="#previewModal"
            >
                Previzualizeaza profil
                <i class="bi bi-eye"></i>
            </button>

            <div
                    class="modal fade"
                    id="previewModal"
                    tabindex="-1"
                    aria-hidden="true"
            >
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Previzualizare</h5>
                            <button
                                    type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                            ></button>
                        </div>

                        <div class="modal-body">
                            {{ include('profile/show.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br>
        <div class="row">
            {{ include('content/pictures/show.html.twig', {images: images, canDelete: canDelete}) }}
        </div>

        <br>
        <a href="{{ path('app_profile_index') }}"
           class="btn btn-primary btn-sm col-sm-3"
        >
            Meniu principal
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0">Profile</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        {#                        <th>Descriere</th> #}
                        <th>Nascut la</th>
                        {#                        <th>Decedat la</th> #}
                        <th style="width:120px">Actiuni</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for profile in profiles %}
                        <tr>
                            <td>{{ profile.name }}</td>

                            {#                            <td class="text-muted" style="max-width: 320px;"> #}
                            {#                                {{ profile.description|u.truncate(80, '…') }} #}
                            {#                            </td> #}

                            {#                            <td> #}
                            {#                                {{ profile.bornAt ? profile.bornAt|date('Y-m-d') : '—' }} #}
                            {#                            </td> #}

                            <td>
                                {{ profile.deceasedAt ? profile.deceasedAt|date('Y-m-d') : 'Alive' }}
                            </td>

                            <td>
                                <a href="{{ path('app_profile_edit', {id: profile.id}) }}"
                                   class="btn btn-sm btn-outline-primary">Editeaza</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No profiles found
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

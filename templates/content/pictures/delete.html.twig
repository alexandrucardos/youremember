<form method="post"
      action="{{ path('app_content_delete', { id: profile.id }) }}"
      class="position-relative top-0 end-0 m-2"
      onsubmit="return confirm('Delete this image?');">

    <input type="hidden" name="image" value="{{ image }}">
    <input type="hidden" name="_token"
           value="{{ csrf_token('delete_image_' ~ image) }}">

    <button type="submit"
            class="btn btn-sm btn-danger">
        sterge
    </button>
</form>
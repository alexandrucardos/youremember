{% if images is empty %}
    <p class="text-muted">Nu exista imagini.</p>
{% else %}
    {% for image in images %}
        <div class="col-4 shadow-sm">
            {% if canDelete|default(false) %}
                {{ include('content/pictures/delete.html.twig', { image: image}) }}
            {% endif %}

            <a data-toggle="lightbox"
               data-gallery="profile-gallery"
               href="{{ image }}"
            >

                <img src="{{ image }}"
                     class="img-fluid"
                     alt="Profile Image {{ loop.index }}">
            </a>
        </div>
    {% endfor %}
{% endif %}
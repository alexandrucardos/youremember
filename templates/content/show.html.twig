{% if images is empty %}
    <p class="text-muted">No images available.</p>
{% else %}
    {% for image in images %}

        <div class="col-xl-3 col-md-12 shadow-sm">

            {% if canDelete|default(false) %}
                {{ include('content/delete.html.twig', { image: image}) }}
            {% endif %}

            <a data-toggle="lightbox"
               data-gallery="profile-gallery"
               href="{{ image }}"
            >

                <img src="{{ image }}"
                     class="img-fluid"
                     alt="Profile Image {{ loop.index }}">
            </a>
        </div>
    {% endfor %}
{% endif %}
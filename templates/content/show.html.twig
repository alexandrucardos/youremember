{% if images is empty %}
    <p class="text-muted">No images available.</p>
{% else %}
    {% for image in images %}
        <div class="col-md-4 shadow-sm">
            <a data-toggle="lightbox"
                    {#                                   data-gallery="profile-gallery" #}
               href="{{ image }}"
            >

                <img src="{{ image }}"
                     class="img-fluid"
                     alt="Profile Image {{ loop.index }}">
            </a>
        </div>
    {% endfor %}
{% endif %}
{% extends 'base.html.twig' %}

{% block body %}
    <h1>File uploaded successfully!</h1>

    <p>You can access it here:</p>

    <a href="{{ url }}" target="_blank">{{ url }}</a>

    <button type="button"
            class="btn btn-outline-primary"
            onclick="window.history.back();">
        <i class="bi bi-arrow-left"></i> Back
    </button>
{% endblock %}

{% extends 'base.html.twig' %}

{% block body %}
    <div class="login-form">
        <h2>Login to Admin Panel</h2>
        <form method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}


            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="username" name="_username" required autofocus>
            </div>

            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="_password" required>
            </div>

            <button type="submit">Login</button>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                   value="{{ csrf_token('authenticate') }}">
        </form>

        <p style="margin-top: 20px; font-size: 12px; color: #666;">
            Demo credentials: admin@example.com / admin123
        </p>
    </div>
{% endblock %}

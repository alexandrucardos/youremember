								"update",
								"dates",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Updates the birth and departure dates for a profile. Requires admin role."
					},
					"response": []
				},
				{
					"name": "Update Profile Obituary",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"obituary\": \"In loving memory of John Doe, a devoted father and friend who will be deeply missed.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/update/obituary/orderId/:order_id",

							],
							"path": [
								"api",
								"v1",
								"update",
								"profile",
								"profile-picture",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Uploads a profile picture for the memorial profile. Requires admin role."
					},
					"response": []
				}
			],
			"description": "Profile management endpoints for creating and updating memorial profiles"
		},
		{
			"name": "Media",
			"item": [
				{
					"name": "Add Media",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/media/add/orderId/:order_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"media",
								"add",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Uploads media files (photos/videos) for a profile. Requires admin role."
					},
					"response": []
				},
				{
					"name": "Delete Media",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"urls\": [\n    \"https://s3.amazonaws.com/bucket/order_id/client/file1.jpg\",\n    \"https://s3.amazonaws.com/bucket/order_id/client/file2.jpg\"\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/media/delete/orderId/:order_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"media",
								"delete",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Deletes media files from a profile. Requires admin role."
					},
					"response": []
				}
			],
			"description": "Media management endpoints for uploading and deleting photos/videos"
		},
		{
			"name": "Media Multipart Upload",
			"item": [
				{
					"name": "Initiate Multipart Upload",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"filename\": \"large-video.mp4\",\n  \"mimeType\": \"video/mp4\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/media/add/multipart/initiate/order_id/:order_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"media",
								"add",
								"multipart",
								"initiate",
								"order_id",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Initiates a multipart upload for large files. Returns upload ID and key."
					},
					"response": []
				},
				{
					"name": "Get Presigned URL for Part",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "hash",
								"value": "guest-hash-123"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"key\": \"order_id/hash/filename.mp4\",\n  \"uploadId\": \"upload-id-from-initiate\",\n  \"partNumber\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/media/add/multipart/part/orderId/:order_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"media",
								"add",
								"multipart",
								"part",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Gets a presigned URL for uploading a specific part of a multipart upload. Requires hash header."
					},
					"response": []
				},
				{
					"name": "Complete Multipart Upload",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "hash",
								"value": "guest-hash-123"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"key\": \"order_id/hash/filename.mp4\",\n  \"uploadId\": \"upload-id-from-initiate\",\n  \"filename\": \"large-video.mp4\",\n  \"mimeType\": \"video/mp4\",\n  \"fileSize\": 52428800,\n  \"parts\": [\n    {\n      \"PartNumber\": 1,\n      \"ETag\": \"etag-from-upload-1\"\n    },\n    {\n      \"PartNumber\": 2,\n      \"ETag\": \"etag-from-upload-2\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/media/add/multipart/complete/eventUuid/:uuid",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"media",
								"add",
								"multipart",
								"complete",
								"eventUuid",
								":uuid"
							],
							"variable": [
								{
									"key": "uuid",
									"value": "profile-uuid-123"
								}
							]
						},
						"description": "Completes a multipart upload after all parts have been uploaded. Requires hash header."
					},
					"response": []
				},
				{
					"name": "Abort Multipart Upload",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "hash",
								"value": "guest-hash-123"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"key\": \"order_id/hash/filename.mp4\",\n  \"uploadId\": \"upload-id-from-initiate\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/media/add/multipart/abort/eventUuid/:uuid",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"media",
								"add",
								"multipart",
								"abort",
								"eventUuid",
								":uuid"
							],
							"variable": [
								{
									"key": "uuid",
									"value": "profile-uuid-123"
								}
							]
						},
						"description": "Aborts a multipart upload. Requires hash header."
					},
					"response": []
				}
			],
			"description": "Multipart upload endpoints for handling large file uploads to S3"
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		}
	]
}

							]
						},
						"description": "Uploads a background image for the profile. Requires admin role."
					},
					"response": []
				},
				{
					"name": "Update Profile Picture",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/update/profile/profile-picture/orderId/:order_id",
							"host": [

								"update",
								"obituary",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Updates the obituary text for a profile. Requires admin role."
					},
					"response": []
				},
				{
					"name": "Update Profile Background",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/update/profile/background/orderId/:order_id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"update",
								"profile",
								"background",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"

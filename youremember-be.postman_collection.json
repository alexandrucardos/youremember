								"v1",
								"update",
								"name",
								"font",
								"orderId",
								":order_id"
							],
							"variable": [
								{
									"key": "order_id",
									"value": "ORD-12345"
								}
							]
						},
						"description": "Updates the profile name and font for a specific order. Requires admin role."
					},
					"response": []
				},
				{
					"name": "Update Profile Dates",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"born_at\": \"1950-01-15\",\n  \"departed_at\": \"2024-12-20\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/update/dates/orderId/:order_id",

								{
									"key": "uuid",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"urls\": [\n\t\t\"path/to/file1.jpg\",\n\t\t\"path/to/file2.jpg\"\n\t]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Delete media files from an event."
					}
				},
				{

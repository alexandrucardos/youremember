						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "hash",
								"value": ""
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/add/multipart/complete/eventUuid/:uuid",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "add", "multipart", "complete", "eventUuid", ":uuid"],
							"variable": [
								{
									"key": "uuid",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"key\": \"s3/key/photo.jpg\",\n\t\"uploadId\": \"upload-id\",\n\t\"filename\": \"photo.jpg\",\n\t\"mimeType\": \"image/jpeg\",\n\t\"fileSize\": 1048576,\n\t\"parts\": [\n\t\t{\"PartNumber\": 1, \"ETag\": \"etag-value\"}\n\t]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Complete a multipart upload and register the file."
					}
				},
				{
					"name": "Multipart Abort",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "hash",
								"value": ""
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/add/multipart/abort/eventUuid/:uuid",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "add", "multipart", "abort", "eventUuid", ":uuid"],
							"variable": [
								{
									"key": "uuid",
									"value": ""

						"body": {
							"mode": "raw",
							"raw": "{\n\t\"key\": \"s3/key/photo.jpg\",\n\t\"uploadId\": \"upload-id\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Abort an in-progress multipart upload."
					}
				}
			]

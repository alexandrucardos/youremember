						"body": {
							"mode": "raw",
							"raw": "{\n\t\"filename\": \"photo.jpg\",\n\t\"mimeType\": \"image/jpeg\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Initiate a multipart upload for a guest. Returns uploadId and key."
					}
				},
				{
					"name": "Multipart Part",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",

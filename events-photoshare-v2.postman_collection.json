						"body": {
							"mode": "raw",
							"raw": "{\n\t\"born_at\": \"1950-01-15\",\n\t\"departed_at\": \"2026-03-10\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Update profile birth and death dates. Requires admin role."
					}
				},
				{
					"name": "Update Profile Picture",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/update/profile/profile-picture/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "update", "profile", "profile-picture", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"description": "Update the profile picture. Requires admin role."
					}
				},
				{
					"name": "Update Profile Background",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/update/profile/background/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "update", "profile", "background", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"description": "Update the background image for a profile. Requires admin role."
					}
				}
			]
		},
		{
			"name": "Media",
			"item": [
				{
					"name": "Add Media",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/add/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "add", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": [],
									"description": "One or more image files"
								}
							]
						},
						"description": "Upload image files to a profile. Requires admin role."
					}
				},
				{
					"name": "Delete Media",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/delete/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "delete", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"urls\": [\n\t\t\"path/to/file1.jpg\",\n\t\t\"path/to/file2.jpg\"\n\t]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Delete media files from a profile. Requires admin role."
					}
				},
				{
					"name": "Multipart Initiate",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/add/multipart/initiate/order_id/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "add", "multipart", "initiate", "order_id", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"filename\": \"photo.jpg\",\n\t\"mimeType\": \"image/jpeg\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Initiate a multipart upload. Returns uploadId and key."
					}
				},
				{
					"name": "Multipart Part",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "hash",
								"value": ""
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/add/multipart/part/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "add", "multipart", "part", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"key\": \"s3/key/photo.jpg\",\n\t\"uploadId\": \"upload-id\",\n\t\"partNumber\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Get a presigned URL for uploading a single part."
					}
				},
				{
					"name": "Multipart Complete",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "hash",
								"value": ""
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/add/multipart/complete/eventUuid/:uuid",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "add", "multipart", "complete", "eventUuid", ":uuid"],
							"variable": [
								{
									"key": "uuid",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"key\": \"s3/key/photo.jpg\",\n\t\"uploadId\": \"upload-id\",\n\t\"filename\": \"photo.jpg\",\n\t\"mimeType\": \"image/jpeg\",\n\t\"fileSize\": 1048576,\n\t\"parts\": [\n\t\t{\"PartNumber\": 1, \"ETag\": \"etag-value\"}\n\t]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Complete a multipart upload and register the file."
					}
				},
				{
					"name": "Multipart Abort",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "hash",
								"value": ""
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/media/add/multipart/abort/eventUuid/:uuid",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "media", "add", "multipart", "abort", "eventUuid", ":uuid"],
							"variable": [
								{
									"key": "uuid",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"key\": \"s3/key/photo.jpg\",\n\t\"uploadId\": \"upload-id\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Abort an in-progress multipart upload."
					}
				}
			]
		}
	]
}
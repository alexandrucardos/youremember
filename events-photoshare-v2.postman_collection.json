							"variable": [
								{
									"key": "uuid",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": [],
									"description": "One or more image files"
								}
							]
						},
						"description": "Upload image files to an event."
					}
				},
				{
					"name": "Delete Media",

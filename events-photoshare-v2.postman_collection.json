								{
									"key": "uuid",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"key\": \"s3/key/photo.jpg\",\n\t\"uploadId\": \"upload-id\",\n\t\"partNumber\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Get a presigned URL for uploading a single part."
					}
				},

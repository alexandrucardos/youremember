{
	"info": {
		"name": "Profile Photoshare - V2",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string",
			"description": "JWT token sent as 'token' header on every request. Parsed by SecurityValidationRequestSubscriber to resolve user role and email."
		}
	],
	"item": [
		{
			"name": "Profile",
			"item": [
				{
					"name": "Create Profile",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "profile"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"order_id\": 123,\n\t\"client_email\": \"client@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Create a new profile. Requires admin role."
					}
				},
				{
					"name": "Get Profile Information by Order ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/profile/information/oderId/:orderId",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "profile", "information", "oderId", ":orderId"],
							"variable": [
								{
									"key": "orderId",
									"value": ""
								}
							]
						},
						"description": "Get profile information by order ID. Requires admin role."
					}
				},
				{
					"name": "Update Profile Name and Font",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/update/name/font/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "update", "name", "font", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"name\": \"John Doe\",\n\t\"font\": \"Arial\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Update profile name and font. Requires admin role."
					}
				},
				{
					"name": "Update Profile Obituary",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/update/obituary/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "update", "obituary", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"obituary\": \"A loving person who will be remembered.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Update profile obituary. Requires admin role."
					}
				},
				{
					"name": "Update Profile Dates",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "token",
								"value": "{{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v2/update/dates/orderId/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "v2", "update", "dates", "orderId", ":order_id"],
							"variable": [
								{
									"key": "order_id",
									"value": ""
								}
							]
